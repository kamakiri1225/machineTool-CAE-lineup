FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    inlet
    {
        type             turbulentIntensityKineticEnergyInlet;
        intensity        0.05;
        value            uniform 1;
    }
    "(top|bottom|ambient)"
    {
        type             inletOutlet;
        inletValue       uniform 1;
        value            uniform 1;
    }
    "(nozzle|plate)"
    {
        type             kqRWallFunction;
        value            uniform 1;
    }
    symmetryPlane
    {
        type             symmetryPlane;
    }
}

