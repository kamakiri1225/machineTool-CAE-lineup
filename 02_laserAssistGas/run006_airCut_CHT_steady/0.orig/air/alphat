FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0.orig/air";
    object      alphat;
}

dimensions      [1 -1 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    "(inlet|ambient)"
    {
        type            calculated;
        value           uniform 0;
    }
    "(nozzle|air_to_plate)"
    {
        type            compressible::alphatJayatillekeWallFunction;
        Prt             0.85;
        value           uniform 0;
    }
    "(front|back)"
    {
        type            wedge;
    }
}
