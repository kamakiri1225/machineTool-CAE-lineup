FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      N2;
}

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.767;

boundaryField
{
    inlet
    {
        type             fixedValue;
        value            uniform 1.0;
    }
    "(top|bottom|ambient)"
    {
        type             inletOutlet;
        inletValue       uniform 0.767;
        value            uniform 0.767;
    }
    "(nozzle|plate)"
    {
        type             zeroGradient;
    }
    symmetryPlane
    {
        type             symmetryPlane;
    }
}

