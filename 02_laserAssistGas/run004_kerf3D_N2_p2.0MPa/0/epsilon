FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 1e4;

boundaryField
{
    inlet
    {
        type             turbulentMixingLengthDissipationRateInlet;
        mixingLength     1e-4;
        value            uniform 1e4;
    }
    "(top|bottom|ambient)"
    {
        type             inletOutlet;
        inletValue       uniform 1e4;
        value            uniform 1e4;
    }
    "(nozzle|plate)"
    {
        type             epsilonWallFunction;
        value            uniform 1e4;
    }
    symmetryPlane
    {
        type             symmetryPlane;
    }
}

