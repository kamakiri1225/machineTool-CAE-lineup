FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    "(inlet|top|bottom|ambient)"
    {
        type             calculated;
        value            uniform 0;
    }
    "(nozzle|plate)"
    {
        type             nutkWallFunction;
        value            uniform 0;
    }
    symmetryPlane
    {
        type             symmetryPlane;
    }
}

