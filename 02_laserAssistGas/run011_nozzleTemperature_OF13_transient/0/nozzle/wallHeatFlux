FoamFile
{
    format      binary;
    class       volScalarField;
    location    "0/nozzle";
    object      wallHeatFlux;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 -3 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    front
    {
        type            wedge;
    }
    back
    {
        type            wedge;
    }
    nozzleMount
    {
        type            calculated;
        value           uniform 0;
    }
    nozzle_to_air
    {
        type            calculated;
        value           uniform 0;
    }
}


