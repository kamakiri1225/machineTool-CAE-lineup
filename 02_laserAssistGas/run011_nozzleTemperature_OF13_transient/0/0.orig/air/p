FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0.orig/air";
    object      p;
}

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325.0;

boundaryField
{
    inlet
    {
        type            uniformTotalPressure;
        p0
        {
            type table;
            values ((0 101325) (0.0002 901325.0) (1 901325.0));
        }
        value           uniform 101325.0;
    }
    ambient
    {
        type            totalPressure;
        p0              uniform 101325.0;
        value           uniform 101325.0;
    }
    "(air_to_nozzle|air_to_plate)"
    {
        type            zeroGradient;
    }
    "(front|back)"
    {
        type            wedge;
    }
}
