FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

application     foamMultiRun;
regionSolvers
{
    air             multicomponentFluid;
    plate           solid;
    nozzle          solid;
}
startFrom       latestTime;
startTime       0;
stopAt          writeNow;
endTime         0.05;
deltaT          1e-9;
writeControl    adjustableRunTime;
writeInterval   0.001;
purgeWrite      0;
writeFormat     binary;
writePrecision  10;
timeFormat      general;
timePrecision   12;
runTimeModifiable true;
adjustTimeStep  yes;
maxCo           0.3;
maxDeltaT       1e-6;
functions
{
    nozzleProbes
    {
        type            probes;
        libs            ("libsampling.so");
        region          nozzle;
        fields          (T);
        interpolationScheme cellPoint;
        writeControl    runTime;
        writeInterval   1e-5;
        probeLocations  (
    (0.00115 0.0009 0)
    (0.00165 0.0023 0)
    (0.00285 0.0023 0)
    (0.0022 0.0035 0)
);
    }
    nozzleAverage
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        region          nozzle;
        cellZone        all;
        operation       volAverage;
        fields          (T);
        writeFields     false;
        writeControl    runTime;
        writeInterval   1e-5;
    }
    fieldBounds
    {
        type            volFieldValue;
        cellZone all;
        operation min;
        writeFields false;
        libs            ("libfieldFunctionObjects.so");
        region          air;
        fields          (p T);
        writeControl    runTime;
        writeInterval   1e-5;
    }
    inletFlow
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        region          air;
        select          patch;
        patch           inlet;
        operation       sum;
        fields          (phi);
        writeFields     false;
        writeControl    runTime;
        writeInterval   1e-5;
    }
    heatNozzle
    {
        type            wallHeatFlux;
        libs            ("libfieldFunctionObjects.so");
        region          nozzle;
        patches         (nozzle_to_air nozzleMount);
        executeControl  runTime;
        executeInterval 1e-5;
        writeControl    runTime;
        writeInterval   1e-5;
    }
}
