FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system/air";
    object      fvSolution;
}

solvers
{
    "rho.*"
    {
        solver          diagonal;
    }
    "p.*"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0.01;
    }
    "(U|h|k|omega|Yi).*"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0;
    }
}

PIMPLE
{
    momentumPredictor yes;
    transonic       yes;
    nCorrectors     2;
    nNonOrthogonalCorrectors 1;
    maxCo           0.2;
    maxDeltaT       1e-6;
    alphaTemp       1;
    rDeltaTSmoothingCoeff 0.02;
    rDeltaTDampingCoeff 1;
}

relaxationFactors
{
    equations
    {
        ".*"            1;
    }
}
