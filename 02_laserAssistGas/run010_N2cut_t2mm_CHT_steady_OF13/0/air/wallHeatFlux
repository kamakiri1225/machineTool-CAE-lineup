FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/air";
    object      wallHeatFlux;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 -3 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0;
    }
    nozzle
    {
        type            calculated;
        value           uniform 0;
    }
    ambient
    {
        type            calculated;
        value           uniform 0;
    }
    front
    {
        type            wedge;
    }
    back
    {
        type            wedge;
    }
    air_to_plate
    {
        type            calculated;
        value           uniform 0;
    }
}


