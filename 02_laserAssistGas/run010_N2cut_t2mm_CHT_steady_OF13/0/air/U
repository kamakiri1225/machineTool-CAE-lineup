FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0.orig/air";
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    "(inlet|ambient)"
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
    "(nozzle|air_to_plate)"
    {
        type            noSlip;
    }
    "(front|back)"
    {
        type            wedge;
    }
}
