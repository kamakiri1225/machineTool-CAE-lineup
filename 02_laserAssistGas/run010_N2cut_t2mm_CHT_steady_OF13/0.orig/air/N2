FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0.orig/air";
    object      N2;
}

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.767;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1.0;
    }
    ambient
    {
        type            inletOutlet;
        inletValue      uniform 0.767;
        value           uniform 0.767;
    }
    "(nozzle|air_to_plate)"
    {
        type            zeroGradient;
    }
    "(front|back)"
    {
        type            wedge;
    }
}
