FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      Ydefault;
}

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    "(inlet|top|bottom|ambient)"
    {
        type             inletOutlet;
        inletValue       uniform 0;
        value            uniform 0;
    }
    "(nozzle|plate)"
    {
        type             zeroGradient;
    }
    symmetryPlane
    {
        type             symmetryPlane;
    }
}

