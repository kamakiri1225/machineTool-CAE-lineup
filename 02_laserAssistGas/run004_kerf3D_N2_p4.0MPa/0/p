FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325.0;

boundaryField
{
    inlet
    {
        type             uniformTotalPressure;
        p0               table ((0 101325.0) (1500 4101325.0) (1e9 4101325.0));
        value            uniform 101325.0;
    }
    "(top|bottom|ambient)"
    {
        type             totalPressure;
        p0               uniform 101325.0;
        value            uniform 101325.0;
    }
    "(nozzle|plate)"
    {
        type             zeroGradient;
    }
    symmetryPlane
    {
        type             symmetryPlane;
    }
}

