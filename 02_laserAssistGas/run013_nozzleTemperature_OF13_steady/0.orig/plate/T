FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0.orig/plate";
    object      T;
}

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300.0;

boundaryField
{
    plateEdge
    {
        type            fixedValue;
        value           uniform 300.0;
    }
    plate_to_air
    {
        type            coupledTemperature;
        value           uniform 300.0;
    }
    "(front|back)"
    {
        type            wedge;
    }
}
