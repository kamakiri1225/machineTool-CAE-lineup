FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0.orig/air";
    object      k;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    inlet
    {
        type            turbulentIntensityKineticEnergyInlet;
        intensity       0.05;
        value           uniform 1;
    }
    ambient
    {
        type            inletOutlet;
        inletValue      uniform 1e-3;
        value           uniform 1;
    }
    "(air_to_nozzle|air_to_plate)"
    {
        type            kqRWallFunction;
        value           uniform 1;
    }
    "(front|back)"
    {
        type            wedge;
    }
}
