FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0.orig/air";
    object      Ydefault;
}

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    "(inlet|ambient)"
    {
        type            inletOutlet;
        inletValue      uniform 0;
        value           uniform 0;
    }
    "(air_to_nozzle|air_to_plate)"
    {
        type            zeroGradient;
    }
    "(front|back)"
    {
        type            wedge;
    }
}
