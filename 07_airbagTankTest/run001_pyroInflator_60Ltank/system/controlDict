FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

application     reactingFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         2e-05;

deltaT          1e-08;

writeControl    adjustable;

writeInterval   0.0005;

purgeWrite      0;

writeFormat     binary;

writePrecision  8;

timeFormat      general;

timePrecision   6;

adjustTimeStep  yes;

maxCo           0.5;

maxDeltaT       1e-05;

runTimeModifiable true;

functions
{
    probes
    {
        type            probes;
        libs            ( sampling );
        fields          ( p T );
        probeLocations  ( ( 0.005 -0.04 0 ) ( 0.15 0.33 0 ) ( 0.01 0.6 0 ) );
        writeControl    timeStep;
        writeInterval   20;
    }
    tankAvg
    {
        type            volFieldValue;
        libs            ( fieldFunctionObjects );
        regionType      cellZone;
        name            tank;
        operation       volAverage;
        fields          ( p T CO2 );
        writeFields     false;
        writeControl    timeStep;
        writeInterval   20;
    }
    chamberAvg
    {
        type            volFieldValue;
        libs            ( fieldFunctionObjects );
        regionType      cellZone;
        name            chamber;
        operation       volAverage;
        fields          ( p T );
        writeFields     false;
        writeControl    timeStep;
        writeInterval   20;
    }
    MachNo
    {
        type            MachNo;
        libs            ( fieldFunctionObjects );
        executeControl  writeTime;
        writeControl    writeTime;
    }
}


