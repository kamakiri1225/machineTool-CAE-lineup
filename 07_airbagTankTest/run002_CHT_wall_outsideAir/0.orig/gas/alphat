FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0.orig/gas";
    object      alphat;
}

dimensions      [1 -1 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    gasInlet
    {
        type            calculated;
        value           uniform 0;
    }
    inflator
    {
        type            compressible::alphatWallFunction;
        value           uniform 0;
    }
    gas_to_wall
    {
        type            compressible::alphatJayatillekeWallFunction;
        Prt             0.85;
        value           uniform 0;
    }
    "(front|back)"
    {
        type            wedge;
    }
}
