FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0.orig/wall";
    object      T;
}

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 293.15;

boundaryField
{
    wallBottom
    {
        type            zeroGradient;
    }
    wall_to_gas
    {
        type            compressible::turbulentTemperatureCoupledBaffleMixed;
        Tnbr            T;
        kappaMethod     solidThermo;
        value           uniform 293.15;
    }
    wall_to_outside
    {
        type            compressible::turbulentTemperatureCoupledBaffleMixed;
        Tnbr            T;
        kappaMethod     solidThermo;
        value           uniform 293.15;
    }
    "(front|back)"
    {
        type            wedge;
    }
}
