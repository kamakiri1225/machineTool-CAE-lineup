FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0.orig/gas";
    object      omega;
}

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 10;

boundaryField
{
    gasInlet
    {
        type            fixedValue;
        value           uniform 1e4;
    }
    ".*"
    {
        type            omegaWallFunction;
        value           uniform 10;
    }
    "(front|back)"
    {
        type            wedge;
    }
}
