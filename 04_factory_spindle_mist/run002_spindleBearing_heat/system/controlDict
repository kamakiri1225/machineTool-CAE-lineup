FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     solidFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         3600;
deltaT          5;
writeControl    runTime;
writeInterval   120;
purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;
functions
{
    Tprobe
    {
        type            probes;
        libs            (sampling);
        fields          (T);
        probeLocations  ((0.001 0.0 0) (0.035 0.05 0) (0.035 0.24 0) (0.089 0.15 0));
        writeControl    timeStep;
        writeInterval   2;
    }
}

