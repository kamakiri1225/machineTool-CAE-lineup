FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

application     chtMultiRegionFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         86400;

deltaT          0.01;

writeControl    adjustable;

writeInterval   1800;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

maxCo           100000;

maxDi           100;

adjustTimeStep  yes;

functions
{
    TCP
    {
        type            probes;
        libs            ( sampling );
        region          machineA;
        fields          ( T );
        probeLocations  ( ( 2.25 0.9 2.1 ) ( 2.25 1.75 2.1 ) );
        writeControl    timeStep;
        writeInterval   1;
    }
    TCPB
    {
        type            probes;
        libs            ( sampling );
        region          machineB;
        fields          ( T );
        probeLocations  ( ( 4.05 0.9 2.1 ) ( 4.05 1.75 2.1 ) );
        writeControl    timeStep;
        writeInterval   1;
    }
}

maxDeltaT       60;


